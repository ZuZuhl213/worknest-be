# SERVER
PORT=8080

# DATABASE (local development only; production secrets come from the deployment environment)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=worknest
DB_USERNAME=worknest
DB_PASSWORD=replace_me

# REDIS (Optional)
REDIS_URL=redis://localhost:6379

# JWT

JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_ISSUER=worknest
JWT_AUDIENCE=worknest-web
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
AUTH_COOKIE_SECURE=false

# GOOGLE SIGN-IN
GOOGLE_CLIENT_ID=

# EMAIL / ACCOUNT RECOVERY
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@worknest.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
PASSWORD_RESET_TOKEN_EXPIRATION=3600000
EMAIL_VERIFICATION_TOKEN_EXPIRATION=86400000

# CLOUDFLARE R2 / AWS S3 (For File Uploads)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET_NAME=your_bucket_name
AWS_REGION=auto

# Malware scanner (mandatory in production)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
